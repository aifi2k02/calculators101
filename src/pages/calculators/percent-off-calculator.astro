---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'
import { getRelated, getBreadcrumbs } from '../../lib/calculators'

const formulaFn = `
  const price = parseFloat(inputs.price)
  const pct = parseFloat(inputs.pct)
  const tax = parseFloat(inputs.tax) || 0
  if (isNaN(price) || price < 0) throw new Error('Enter the original price.')
  if (isNaN(pct) || pct < 0) throw new Error('Enter the percent off.')
  const saved = price * (pct / 100)
  const sale = price - saved
  const taxAmt = sale * (tax / 100)
  const finalPrice = sale + taxAmt
  const money = x => '$' + x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  const stats = [
    { label: 'Sale price', value: money(sale) },
    { label: 'You save', value: money(saved) },
    { label: 'Original', value: money(price) },
    { label: 'Discount', value: pct + '%' }
  ]
  const breakdown = [
    'Original price: ' + money(price),
    'Discount: ' + pct + '% off = ' + money(saved) + ' saved',
    'Sale price: ' + money(price) + ' − ' + money(saved) + ' = ' + money(sale)
  ]
  if (tax > 0) {
    breakdown.push('Sales tax (' + tax + '%): ' + money(taxAmt))
    breakdown.push('Final price with tax: ' + money(finalPrice))
    stats[0] = { label: 'Final price (with tax)', value: money(finalPrice) }
  }
  return {
    value: money(tax > 0 ? finalPrice : sale),
    share: {
      kicker: pct + '% off',
      heroNumber: money(saved),
      heroSub: 'saved on a ' + money(price) + ' item',
      hook: 'Paid just ' + money(tax > 0 ? finalPrice : sale) + ' after a ' + pct + '% discount.',
      chips: ['Was ' + money(price), pct + '% off', 'Now ' + money(tax > 0 ? finalPrice : sale)]
    },
    stats,
    breakdown
  }
`

const faqs = [
  { question: 'How do you calculate percent off?', answer: 'Multiply the original price by the discount percentage (as a decimal) to get the amount saved, then subtract that from the original price. For example, 25% off a $80 item is 80 × 0.25 = $20 saved, so the sale price is $80 − $20 = $60.' },
  { question: 'How do I figure out the final price after a discount?', answer: 'Sale price = original price × (1 − discount%). A quick shortcut: for 30% off, you pay 70% of the price, so multiply by 0.70. This calculator also adds sales tax on the discounted price if you enter a tax rate, giving you the true out-the-door total.' },
  { question: 'Is sales tax charged before or after the discount?', answer: 'Almost always after. Retailers apply the discount first, then calculate sales tax on the lower, discounted price — so a coupon reduces the tax you pay too. This calculator follows that standard order: discount first, then tax on the sale price.' },
  { question: 'How do I stack two discounts, like 20% off then an extra 10%?', answer: 'Stacked discounts multiply, they do not add. Take 20% off first (pay 80%), then 10% off that (pay 90% of the new price): 0.80 × 0.90 = 0.72, so you pay 72% of the original — a 28% total discount, not 30%. Run this calculator twice, using the first sale price as the second original price.' },
  { question: 'What is the difference between percent off and percentage?', answer: 'Percent off is a specific discount applied to a price to find savings and a sale price. A general percentage calculation can find any part of a whole ("what is 15% of 200"). For discounts and sales, percent off is the right tool; for other percentage questions, use a percentage calculator.' },
]
---
<Layout
  title="Percent Off Calculator: Sale Price & Savings"
  description="Calculate the sale price and how much you save with any percent-off discount, plus optional sales tax. Free percent off calculator with a shareable result."
  breadcrumbs={getBreadcrumbs('/calculators/percent-off-calculator')}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/financial" class="hover:text-blue-600">Financial</a><span>›</span>
      <a href="/calculators/financial#budget" class="hover:text-blue-600">Budget &amp; Spending</a><span>›</span>
      <span class="text-gray-900">Percent Off Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Percent Off Calculator"
          description="The sale price and savings on any discount"
          formulaId="percent-off"
          formulaFn={formulaFn}
          resultLabel="Sale Price"
          shareStyle="money"
          inputs={[
            { id: 'price', label: 'Original price ($)', type: 'number', placeholder: '80', min: 0, step: 'any', defaultValue: 80 },
            { id: 'pct', label: 'Percent off (%)', type: 'number', placeholder: '25', min: 0, step: 'any', defaultValue: 25 },
            { id: 'tax', label: 'Sales tax (%, optional)', type: 'number', placeholder: '0', min: 0, step: 'any' },
          ]}
          faqs={faqs}
          relatedCalcs={getRelated('/calculators/percent-off-calculator')}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 text-sm text-blue-900 leading-relaxed">
          <h3 class="font-bold mb-2">Discount shortcuts</h3>
          <div class="space-y-1 text-xs">
            <div class="flex justify-between"><span>10% off</span><span>pay ×0.90</span></div>
            <div class="flex justify-between"><span>25% off</span><span>pay ×0.75</span></div>
            <div class="flex justify-between"><span>1/3 off</span><span>pay ×0.667</span></div>
            <div class="flex justify-between"><span>50% off</span><span>pay ×0.50</span></div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
