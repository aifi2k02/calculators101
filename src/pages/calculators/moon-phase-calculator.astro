---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'
import { getRelated, getBreadcrumbs } from '../../lib/calculators'

const formulaFn = `
  const dStr = inputs.date
  if (!dStr) throw new Error('Pick a date.')
  const d = new Date(dStr + 'T12:00:00Z')
  if (isNaN(d.getTime())) throw new Error('Enter a valid date.')
  const SYN = 29.530588853
  const KNOWN_NEW = 2451550.1  // JD of new moon 2000-01-06 18:14 UT
  let Y = d.getUTCFullYear(), M = d.getUTCMonth() + 1, D = d.getUTCDate() + 0.5
  let yy = Y, mm = M
  if (mm <= 2) { yy -= 1; mm += 12 }
  const A = Math.floor(yy / 100), B = 2 - A + Math.floor(A / 4)
  const JD = Math.floor(365.25 * (yy + 4716)) + Math.floor(30.6001 * (mm + 1)) + D + B - 1524.5
  let age = (JD - KNOWN_NEW) % SYN
  if (age < 0) age += SYN
  const frac = age / SYN
  const illum = Math.round((1 - Math.cos(2 * Math.PI * frac)) / 2 * 100)
  const phases = [
    { n: 'New Moon', e: '🌑' }, { n: 'Waxing Crescent', e: '🌒' }, { n: 'First Quarter', e: '🌓' },
    { n: 'Waxing Gibbous', e: '🌔' }, { n: 'Full Moon', e: '🌕' }, { n: 'Waning Gibbous', e: '🌖' },
    { n: 'Last Quarter', e: '🌗' }, { n: 'Waning Crescent', e: '🌘' }
  ]
  let idx
  if (age < 1.84566) idx = 0
  else if (age < 5.53699) idx = 1
  else if (age < 9.22831) idx = 2
  else if (age < 12.91963) idx = 3
  else if (age < 16.61096) idx = 4
  else if (age < 20.30228) idx = 5
  else if (age < 23.99361) idx = 6
  else if (age < 27.68493) idx = 7
  else idx = 0
  const phase = phases[idx]
  const daysToNew = (SYN - age) % SYN
  let daysToFull = (SYN / 2 - age); if (daysToFull < 0) daysToFull += SYN
  return {
    value: phase.e + ' ' + phase.n,
    stats: [
      { label: 'Phase', value: phase.n },
      { label: 'Illumination', value: illum + '%' },
      { label: 'Moon Age', value: age.toFixed(1) + ' days' },
      { label: 'Next Full Moon', value: Math.round(daysToFull) + 'd' }
    ],
    breakdown: [
      'Date: ' + d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }),
      '—',
      'Phase: ' + phase.e + ' ' + phase.n,
      'Illumination: ' + illum + '% of the disc lit',
      'Moon age: ' + age.toFixed(1) + ' days into the ' + SYN.toFixed(1) + '-day cycle',
      'Next new moon: in ' + Math.round(daysToNew) + ' days',
      'Next full moon: in ' + Math.round(daysToFull) + ' days'
    ],
    share: {
      kicker: 'Moon phase',
      heroNumber: illum + '%',
      heroSub: phase.n + ' — ' + illum + '% illuminated',
      hook: phase.e + ' The moon is ' + age.toFixed(1) + ' days old; next full moon in ' + Math.round(daysToFull) + ' days.',
      chips: [phase.n, illum + '% lit', 'Age ' + age.toFixed(1) + 'd']
    }
  }
`

const faqs = [
  { question: 'How is the moon phase calculated?', answer: 'The calculator finds how many days have passed since a known new moon, then divides by the length of the lunar cycle (29.53 days) to place the moon within its phase. From that position it derives the phase name, the moon\'s age in days, and the illuminated fraction of the disc.' },
  { question: 'What are the eight moon phases?', answer: 'In order: New Moon (dark), Waxing Crescent, First Quarter (half lit, growing), Waxing Gibbous, Full Moon (fully lit), Waning Gibbous, Last Quarter (half lit, shrinking), and Waning Crescent — then back to new. "Waxing" means growing brighter; "waning" means fading.' },
  { question: 'What does illumination percentage mean?', answer: 'It is the fraction of the moon\'s visible disc that is lit by the sun. 0% is a new moon, 50% is a quarter moon, and 100% is a full moon. The percentage is the same worldwide on a given date, even though the moon looks flipped between the Northern and Southern Hemispheres.' },
  { question: 'How accurate is this moon phase calculator?', answer: 'It is accurate to within a few percent of illumination and reliably correct on the phase name for any date, past or future. It uses a mean lunar cycle, so it can differ by a few hours from precise astronomical tables, which account for the moon\'s slightly irregular orbit.' },
  { question: 'When is the next full moon?', answer: 'Pick today\'s date and the calculator shows the days until the next full moon and the next new moon. Full moons occur about every 29.5 days, so there is usually one each month — occasionally two, the second of which is called a blue moon.' },
]
---
<Layout
  title="Moon Phase Calculator: Phase & Illumination for Any Date"
  description="Find the moon phase, illumination percentage, and days to the next full moon for any date. Free moon phase calculator with the 8 lunar phases."
  breadcrumbs={getBreadcrumbs('/calculators/moon-phase-calculator')}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/other" class="hover:text-blue-600">Other</a><span>›</span>
      <a href="/calculators/science" class="hover:text-blue-600">Science &amp; Weather</a><span>›</span>
      <span class="text-gray-900">Moon Phase Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Moon Phase Calculator"
          description="The moon phase, illumination, and next full moon for any date"
          formulaId="moon-phase"
          formulaFn={formulaFn}
          resultLabel="Moon Phase"
          shareStyle="time"
          inputs={[
            { id: 'date', label: 'Pick a Date', type: 'date', defaultValue: '2026-01-03' },
          ]}
          intro="This moon phase calculator shows the lunar phase for any date — its name, the percentage of the disc illuminated, the moon's age in days, and how long until the next full and new moon. Great for planning stargazing, photography, camping, or just curiosity."
          disclaimer="Uses the mean 29.53-day lunar cycle. Phase names are reliable for any date; illumination is accurate to within a few percent and can differ by a few hours from precise ephemeris tables."
          lastUpdated="2026-07-26"
          faqs={faqs}
          relatedCalcs={getRelated('/calculators/moon-phase-calculator')}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5">
          <h3 class="font-bold text-blue-900 mb-3">The 8 phases</h3>
          <div class="space-y-1.5 text-xs text-blue-800">
            {[['🌑','New Moon','0%'],['🌒','Waxing Crescent','~25%'],['🌓','First Quarter','50%'],['🌔','Waxing Gibbous','~75%'],['🌕','Full Moon','100%'],['🌖','Waning Gibbous','~75%'],['🌗','Last Quarter','50%'],['🌘','Waning Crescent','~25%']].map(([e,n,p]) => (
              <div class="flex justify-between border-b border-blue-100 pb-1"><span>{e} {n}</span><span class="font-medium">{p}</span></div>
            ))}
          </div>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
          <h3 class="font-semibold text-gray-900 text-sm mb-1">Waxing vs waning</h3>
          <p class="text-xs text-gray-600"><strong>Waxing</strong> = getting brighter (new → full). <strong>Waning</strong> = fading (full → new).</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
