---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'
import { getRelated, getBreadcrumbs } from '../../lib/calculators'

const formulaFn = `
  const salary = parseFloat(inputs.salary) || 0
  const rtype = inputs.rtype || 'pct'
  const rval = parseFloat(inputs.rval) || 0
  const filing = inputs.filing || 'single'
  const inflIn = parseFloat(inputs.inflation)
  const inflR = (isNaN(inflIn) ? 3.3 : inflIn) / 100
  if (salary <= 0) throw new Error('Enter your current annual salary.')
  const raise = rtype === 'pct' ? salary * rval / 100 : rval
  if (raise < 0) throw new Error('Raise cannot be negative.')
  const newSalary = salary + raise
  const STD = { single: 16100, mfj: 32200 }
  const BR = {
    single: [[12400,0.10],[50400,0.12],[105700,0.22],[201775,0.24],[256225,0.32],[640600,0.35],[Infinity,0.37]],
    mfj: [[24800,0.10],[100800,0.12],[211400,0.22],[403550,0.24],[512450,0.32],[768700,0.35],[Infinity,0.37]]
  }
  const taxableNew = Math.max(0, newSalary - STD[filing])
  let marg = BR[filing][0][1]
  for (const b of BR[filing]) { marg = b[1]; if (taxableNew <= b[0]) break }
  const fica = 0.0765
  const combined = marg + fica
  const afterTaxRaise = raise * (1 - combined)
  const nominalPct = raise / salary * 100
  const realPct = ((1 + raise / salary) / (1 + inflR) - 1) * 100
  const afterTaxMonthly = afterTaxRaise / 12
  const beatInflation = nominalPct >= inflR * 100
  return {
    value: (realPct >= 0 ? '+' : '') + realPct.toFixed(1) + '% real',
    gaugeValue: Math.max(-5, Math.min(realPct, 15)),
    stats: [
      { label: 'New Salary', value: '$' + Math.round(newSalary).toLocaleString() },
      { label: 'Raise (gross)', value: '$' + Math.round(raise).toLocaleString() + ' (' + nominalPct.toFixed(1) + '%)' },
      { label: 'Take-Home / mo', value: '$' + Math.round(afterTaxMonthly).toLocaleString() },
      { label: 'Real Raise', value: (realPct >= 0 ? '+' : '') + realPct.toFixed(1) + '%' }
    ],
    breakdown: [
      'Current salary: $' + Math.round(salary).toLocaleString(),
      'Raise: ' + nominalPct.toFixed(2) + '% = $' + Math.round(raise).toLocaleString(),
      'New salary: $' + Math.round(newSalary).toLocaleString(),
      '—',
      'Marginal federal rate on the raise: ' + (marg * 100).toFixed(0) + '%',
      'Payroll tax (Social Security + Medicare): 7.65%',
      'After-tax raise: $' + Math.round(afterTaxRaise).toLocaleString() + '/yr = $' + Math.round(afterTaxMonthly).toLocaleString() + '/mo',
      '—',
      'Inflation assumption: ' + (inflR * 100).toFixed(1) + '%',
      'Real (inflation-adjusted) raise: ' + (realPct >= 0 ? '+' : '') + realPct.toFixed(2) + '%',
      beatInflation ? 'Your raise beat inflation.' : 'Your raise did NOT keep up with inflation.'
    ],
    share: {
      kicker: 'My real pay raise',
      heroNumber: (realPct >= 0 ? '+' : '') + realPct.toFixed(1) + '%',
      heroSub: 'real raise after tax & inflation (headline was ' + nominalPct.toFixed(1) + '%)',
      hook: 'That ' + nominalPct.toFixed(1) + '% raise adds $' + Math.round(afterTaxMonthly).toLocaleString() + '/mo take-home — but ' + (inflR*100).toFixed(1) + '% inflation eats most of it.',
      chips: ['+$' + Math.round(afterTaxMonthly).toLocaleString() + '/mo', nominalPct.toFixed(1) + '% gross', (realPct >= 0 ? '+' : '') + realPct.toFixed(1) + '% real']
    }
  }
`

const gauge = {
  min: -5, max: 15, unit: '%',
  zones: [
    { label: 'Pay cut (real)', color: '#ef4444', from: -5, to: 0 },
    { label: 'Barely keeps up', color: '#f59e0b', from: 0, to: 2 },
    { label: 'Real gain', color: '#22c55e', from: 2, to: 15 },
  ]
}

const faqs = [
  { question: 'How do I calculate my real pay raise?', answer: 'Start with the headline raise percentage, then subtract what taxes and inflation take. Taxes reduce the cash you keep (your marginal federal rate plus 7.65% payroll tax), and inflation reduces what that money buys. This calculator does both: it shows your after-tax take-home increase and your inflation-adjusted "real" raise.' },
  { question: 'Why is my raise worth less than the percentage?', answer: 'Two reasons. First, the extra income is taxed at your marginal rate (often 22%+ federal) plus 7.65% Social Security and Medicare — so you keep roughly 65–75 cents of each raise dollar. Second, if prices rise 3%, a 3% raise leaves your buying power flat. A "5% raise" can be a ~1–2% real gain.' },
  { question: 'What raise do I need to keep up with inflation?', answer: 'At least the inflation rate. With 2026 inflation around 3.3%, a raise below 3.3% is effectively a pay cut in real terms — your salary buys less than it did last year. To get ahead, your raise needs to exceed inflation.' },
  { question: 'Is the after-tax figure exact?', answer: 'It is a close federal estimate. It applies your marginal federal bracket plus 7.65% payroll tax to the raise amount. It does not include state income tax, which would lower the take-home figure further in most states.' },
  { question: 'Should I negotiate based on gross or real raise?', answer: 'Understand both. Negotiate the gross number (that is what employers quote), but evaluate the offer using the real, after-inflation figure. If inflation is 3.3% and you are offered 3%, you are technically going backward and have a strong case to ask for more.' },
]
---
<Layout
  title="Pay Raise Calculator: Your Real Raise After Tax & Inflation"
  description="See what your pay raise is really worth after taxes and inflation — take-home increase per month and your real, inflation-adjusted raise. Free pay raise calculator."
  breadcrumbs={getBreadcrumbs('/calculators/pay-raise-calculator')}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/financial" class="hover:text-blue-600">Financial</a><span>›</span>
      <a href="/calculators/income" class="hover:text-blue-600">Income &amp; Pay</a><span>›</span>
      <span class="text-gray-900">Pay Raise Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Pay Raise Calculator"
          description="What your raise is really worth after tax and inflation"
          formulaId="pay-raise"
          formulaFn={formulaFn}
          resultLabel="Real (Inflation-Adjusted) Raise"
          shareStyle="money"
          inputs={[
            { id: 'salary', label: 'Current Annual Salary', type: 'number', placeholder: '80000', min: 0, step: 100, unit: '$', defaultValue: 80000 },
            { id: 'rtype', label: 'Raise Given As', type: 'select', options: [
              { value: 'pct', label: 'Percentage (%)' },
              { value: 'amt', label: 'Dollar amount ($)' },
            ], defaultValue: 'pct' },
            { id: 'rval', label: 'Raise Amount (% or $ per above)', type: 'number', placeholder: '5', min: 0, step: 0.1, defaultValue: 5 },
            { id: 'filing', label: 'Filing Status', type: 'select', options: [
              { value: 'single', label: 'Single' },
              { value: 'mfj', label: 'Married filing jointly' },
            ], defaultValue: 'single' },
            { id: 'inflation', label: 'Expected Inflation', type: 'number', placeholder: '3.3', min: 0, max: 30, step: 0.1, unit: '%', defaultValue: 3.3 },
          ]}
          gauge={gauge}
          intro="This pay raise calculator shows what your raise is actually worth once taxes and inflation are accounted for. It applies your marginal federal tax rate plus 7.65% payroll tax to find your real take-home increase per month, and adjusts for inflation to reveal your true 'real' raise — often far smaller than the headline number."
          disclaimer="After-tax figures are a federal estimate (marginal bracket + 7.65% FICA) and exclude state income tax. Inflation defaults to the ~3.3% 2026 rate — adjust as needed. 2026 brackets per IRS Rev. Proc. 2025-32."
          lastUpdated="2026-07-25"
          faqs={faqs}
          relatedCalcs={getRelated('/calculators/pay-raise-calculator')}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5">
          <h3 class="font-bold text-blue-900 mb-2">The 2026 reality</h3>
          <p class="text-xs text-blue-800">Average U.S. raise budgets for 2026 are ~<strong>3.3–3.5%</strong> — barely above the ~<strong>3.3%</strong> inflation rate. Many "raises" are close to a real-terms wash.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <h3 class="font-bold text-gray-900 text-sm mb-3">Raise vs inflation (3.3%)</h3>
          <table class="w-full text-xs text-gray-700">
            <thead><tr class="text-gray-500"><th class="text-left pb-1">Raise</th><th class="text-right pb-1">Real raise</th></tr></thead>
            <tbody>
              {[['2%','−1.3%'],['3.3%','0.0%'],['5%','+1.6%'],['7%','+3.6%'],['10%','+6.5%']].map(([r,v]) => (
                <tr class="border-t border-gray-100"><td class="py-1 font-medium">{r}</td><td class="py-1 text-right">{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
          <h3 class="font-semibold text-amber-900 text-sm mb-1">Negotiation tip</h3>
          <p class="text-xs text-amber-800">Anything below the inflation rate is a real pay cut. That's leverage — bring it to the table.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
