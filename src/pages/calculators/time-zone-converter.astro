---
import Layout from '../../layouts/Layout.astro'
import { getBreadcrumbs, getRelated } from '../../lib/calculators'
const related = getRelated('/calculators/time-zone-converter')

const faqs = [
  { question: 'How does the time zone converter work?', answer: 'Pick a date and time, the zone it is in ("from"), and the zone you want it in ("to"). The converter uses your browser\'s built-in time-zone database — the same IANA data that powers operating systems — to translate the time accurately, including daylight saving time changes.' },
  { question: 'Does it handle daylight saving time?', answer: 'Yes. Because it uses the official IANA time-zone rules, it automatically applies the correct offset for the exact date you choose, including DST transitions. A time in July and the same clock time in January can convert differently, and this tool gets both right.' },
  { question: 'What time zones are supported?', answer: 'Every named IANA time zone your browser knows — hundreds of them, covering all countries and regions (for example America/New_York, Europe/London, Asia/Tokyo, Australia/Sydney), plus UTC. Start typing in the dropdown to find a city or region quickly.' },
  { question: 'Is my time converted privately?', answer: 'Completely. All conversion happens in your browser using its local time-zone engine — nothing you enter is sent to a server. It works offline once the page has loaded.' },
  { question: 'How do I plan a meeting across time zones?', answer: 'Enter the proposed time in your own zone as the "from" value, then switch the "to" zone to each participant\'s location to see their local time. Repeat for each city, or use it to find a slot that is reasonable for everyone.' },
]

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Time Zone Converter',
  description: 'Free time zone converter. Convert any time between IANA time zones with accurate daylight saving handling, entirely in your browser.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  browserRequirements: 'Requires JavaScript',
}
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
}
---
<Layout
  title="Time Zone Converter: Convert Time Between Any Time Zones"
  description="Convert any time between world time zones with accurate daylight saving handling. Free time zone converter and meeting planner — private, in your browser."
  breadcrumbs={getBreadcrumbs('/calculators/time-zone-converter')}
>
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/other" class="hover:text-blue-600">Other</a><span>›</span>
      <a href="/calculators/date-time" class="hover:text-blue-600">Date &amp; Time</a><span>›</span>
      <span class="text-gray-900">Time Zone Converter</span>
    </nav>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="bg-white rounded-3xl shadow-xl shadow-blue-100/60 border border-gray-200/80 overflow-hidden">
          <div class="bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-700 px-6 py-5">
            <h1 class="text-xl font-bold text-white">Time Zone Converter</h1>
            <p class="text-blue-100/90 text-sm mt-1">Convert any time between world time zones — DST-accurate</p>
          </div>
          <div class="p-6">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5" for="tz-datetime">Date &amp; time</label>
                <input type="datetime-local" id="tz-datetime" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5" for="tz-from">From time zone</label>
                <select id="tz-from" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></select>
              </div>
            </div>

            <div class="flex justify-center my-3">
              <button id="tz-swap" class="text-xs border border-gray-200 hover:border-blue-400 bg-white hover:bg-blue-50 text-gray-600 hover:text-blue-700 py-1.5 px-4 rounded-full transition-colors flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
                Swap
              </button>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5" for="tz-to">To time zone</label>
              <select id="tz-to" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <!-- Result -->
            <div id="tz-result" class="hidden mt-6 rounded-2xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 p-5 text-center">
              <p id="tz-out-time" class="text-4xl font-bold text-gray-900">—</p>
              <p id="tz-out-date" class="text-sm text-gray-600 mt-1"></p>
              <p id="tz-sentence" class="text-sm text-blue-800 mt-3 font-medium"></p>
              <div class="mt-3 flex flex-wrap gap-2 justify-center">
                <span id="tz-diff" class="text-xs bg-white border border-blue-200 text-blue-700 font-semibold px-2.5 py-1 rounded-full"></span>
                <span id="tz-from-off" class="text-xs bg-white border border-gray-200 text-gray-600 px-2.5 py-1 rounded-full"></span>
                <span id="tz-to-off" class="text-xs bg-white border border-gray-200 text-gray-600 px-2.5 py-1 rounded-full"></span>
              </div>
              <button id="tz-copy" class="mt-4 text-xs border border-blue-200 hover:border-blue-400 bg-white py-2 px-4 rounded-lg text-blue-700 font-semibold transition-colors">Copy converted time</button>
            </div>
          </div>
        </div>

        <div class="mt-10 max-w-2xl">
          <h2 class="text-lg font-semibold text-gray-800 mb-3">Frequently Asked Questions</h2>
          <div class="space-y-3">
            {faqs.map(faq => (
              <details class="bg-white border border-gray-200 rounded-lg px-4 py-3 group">
                <summary class="text-sm font-medium text-gray-800 cursor-pointer list-none flex justify-between items-center gap-3">
                  {faq.question}
                  <svg class="w-4 h-4 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <p class="mt-2 text-sm text-gray-600 leading-relaxed">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-100 rounded-xl px-5 py-4 text-sm text-gray-700 leading-relaxed">
          <p>A free, accurate time zone converter and meeting planner. Convert any date and time between hundreds of world time zones using the official IANA database built into your browser — daylight saving time handled automatically, entirely private.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <h3 class="font-semibold text-gray-900 text-sm mb-3">Popular conversions</h3>
          <div class="space-y-1.5 text-xs text-gray-600">
            <div>New York → London (+5h)</div>
            <div>London → Tokyo (+9h)</div>
            <div>Los Angeles → New York (+3h)</div>
            <div>UTC → India (+5:30)</div>
          </div>
          <p class="text-[11px] text-gray-400 mt-2">Offsets shift with daylight saving — the tool uses the exact date you pick.</p>
        </div>
      </aside>
    </div>

    <!-- Related calculators (silo-scoped) -->
    {related.length > 0 && (
      <div class="mt-10 max-w-2xl">
        <h2 class="text-base font-semibold text-gray-800 mb-3">Related Calculators</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {related.map(rc => (
            <a href={rc.href} class="bg-white border border-gray-200 hover:border-blue-300 hover:bg-blue-50 rounded-lg px-3 py-2.5 text-sm text-gray-700 hover:text-blue-700 transition-colors font-medium">{rc.name}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  const fromSel = document.getElementById('tz-from') as HTMLSelectElement
  const toSel = document.getElementById('tz-to') as HTMLSelectElement
  const dtInput = document.getElementById('tz-datetime') as HTMLInputElement
  const swapBtn = document.getElementById('tz-swap') as HTMLButtonElement
  const resultBox = document.getElementById('tz-result')!
  const outTime = document.getElementById('tz-out-time')!
  const outDate = document.getElementById('tz-out-date')!
  const sentence = document.getElementById('tz-sentence')!
  const diffEl = document.getElementById('tz-diff')!
  const fromOffEl = document.getElementById('tz-from-off')!
  const toOffEl = document.getElementById('tz-to-off')!
  const copyBtn = document.getElementById('tz-copy') as HTMLButtonElement

  const local = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
  let zones: string[]
  try { zones = (Intl as any).supportedValuesOf('timeZone') } catch { zones = [] }
  if (!zones.length) zones = ['UTC','America/New_York','America/Chicago','America/Denver','America/Los_Angeles','Europe/London','Europe/Paris','Europe/Berlin','Asia/Dubai','Asia/Kolkata','Asia/Singapore','Asia/Tokyo','Australia/Sydney']
  if (!zones.includes('UTC')) zones.unshift('UTC')

  const cityOf = (tz: string) => tz.split('/').pop()!.replace(/_/g, ' ')
  function fill(sel: HTMLSelectElement, selected: string) {
    sel.innerHTML = zones.map(z => `<option value="${z}"${z === selected ? ' selected' : ''}>${z.replace(/_/g, ' ')}</option>`).join('')
  }
  fill(fromSel, local)
  fill(toSel, local === 'America/New_York' ? 'Europe/London' : 'America/New_York')

  // default datetime = now (local wall clock)
  const now = new Date()
  const pad = (n: number) => String(n).padStart(2, '0')
  dtInput.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`

  function offsetMin(tz: string, date: Date) {
    const dtf = new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' })
    const m: any = {}; dtf.formatToParts(date).forEach(p => m[p.type] = p.value)
    const asUTC = Date.UTC(+m.year, +m.month - 1, +m.day, +m.hour, +m.minute, +m.second)
    return (asUTC - date.getTime()) / 60000
  }
  function zonedToUtc(y: number, mo: number, d: number, h: number, mi: number, tz: string) {
    const guess = Date.UTC(y, mo - 1, d, h, mi)
    let off = offsetMin(tz, new Date(guess))
    let utc = guess - off * 60000
    off = offsetMin(tz, new Date(utc))
    utc = guess - off * 60000
    return new Date(utc)
  }
  function offLabel(tz: string, date: Date) {
    const p = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'shortOffset' }).formatToParts(date).find(x => x.type === 'timeZoneName')
    return p ? p.value : ''
  }

  let lastCopy = ''
  function convert() {
    if (!dtInput.value) { resultBox.classList.add('hidden'); return }
    const [datePart, timePart] = dtInput.value.split('T')
    const [y, mo, d] = datePart.split('-').map(Number)
    const [h, mi] = timePart.split(':').map(Number)
    const fromTz = fromSel.value, toTz = toSel.value
    const instant = zonedToUtc(y, mo, d, h, mi, fromTz)

    const timeStr = new Intl.DateTimeFormat('en-US', { timeZone: toTz, hour: 'numeric', minute: '2-digit', hour12: true }).format(instant)
    const dateStr = new Intl.DateTimeFormat('en-US', { timeZone: toTz, weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }).format(instant)
    const fromTimeStr = new Intl.DateTimeFormat('en-US', { timeZone: fromTz, hour: 'numeric', minute: '2-digit', hour12: true }).format(instant)

    outTime.textContent = timeStr
    outDate.textContent = dateStr
    sentence.textContent = `When it's ${fromTimeStr} in ${cityOf(fromTz)}, it's ${timeStr} in ${cityOf(toTz)}.`

    const dh = (offsetMin(toTz, instant) - offsetMin(fromTz, instant)) / 60
    const dhStr = (dh === 0) ? 'Same time' : (dh > 0 ? '+' : '') + (Number.isInteger(dh) ? dh : dh.toFixed(1)) + 'h difference'
    diffEl.textContent = dhStr
    fromOffEl.textContent = cityOf(fromTz) + ' ' + offLabel(fromTz, instant)
    toOffEl.textContent = cityOf(toTz) + ' ' + offLabel(toTz, instant)
    lastCopy = `${timeStr}, ${dateStr} (${cityOf(toTz)})`
    resultBox.classList.remove('hidden')
  }

  ;[dtInput, fromSel, toSel].forEach(el => el.addEventListener('input', convert))
  swapBtn.addEventListener('click', () => { const t = fromSel.value; fromSel.value = toSel.value; toSel.value = t; convert() })
  copyBtn.addEventListener('click', () => {
    if (!lastCopy) return
    navigator.clipboard.writeText(lastCopy).then(() => { copyBtn.textContent = '✓ Copied!'; setTimeout(() => copyBtn.textContent = 'Copy converted time', 2000) })
  })
  convert()
</script>
