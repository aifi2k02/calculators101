---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'

const formulaFn = `
  const length = parseFloat(inputs.length)
  const width = parseFloat(inputs.width)
  const unit = inputs.unit || 'feet'
  const qty = parseFloat(inputs.qty) || 1
  const price = parseFloat(inputs.price) || 0
  if (isNaN(length) || length <= 0) throw new Error('Enter the length.')
  if (isNaN(width) || width <= 0) throw new Error('Enter the width.')
  // Convert linear unit to feet
  const toFeet = { feet: 1, inches: 1 / 12, yards: 3, meters: 3.280839895 }
  const f = toFeet[unit]
  const sqftEach = (length * f) * (width * f)
  const sqft = sqftEach * qty
  const sqm = sqft / 10.763910417
  const sqyd = sqft / 9
  const round = x => Math.round(x * 100) / 100
  const money = x => '$' + x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  const stats = [
    { label: 'Total area', value: round(sqft).toLocaleString('en-US') + ' ft²' },
    { label: 'Square meters', value: round(sqm).toLocaleString('en-US') + ' m²' },
    { label: 'Square yards', value: round(sqyd).toLocaleString('en-US') + ' yd²' },
    { label: 'Area per unit', value: round(sqftEach).toLocaleString('en-US') + ' ft²' }
  ]
  const breakdown = [
    'Length: ' + length + ' ' + unit + '  ×  Width: ' + width + ' ' + unit,
    'Area each = ' + round(sqftEach).toLocaleString('en-US') + ' ft²',
    'Quantity: ' + qty,
    'Total area: ' + round(sqft).toLocaleString('en-US') + ' ft² (' + round(sqm).toLocaleString('en-US') + ' m²)'
  ]
  if (price > 0) {
    const cost = sqft * price
    breakdown.push('Cost = ' + round(sqft).toLocaleString('en-US') + ' ft² × ' + money(price) + '/ft² = ' + money(cost))
    stats[3] = { label: 'Total cost', value: money(cost) }
  }
  return { value: round(sqft).toLocaleString('en-US') + ' ft²', stats, breakdown }
`

const faqs = [
  { question: 'How do I calculate square footage?', answer: 'For a rectangular area, multiply the length by the width in feet: area = length × width. A room 12 feet by 10 feet is 120 square feet. If your measurements are in inches, yards, or meters, this calculator converts them to feet automatically before multiplying.' },
  { question: 'How do I find square footage from inches or meters?', answer: 'Convert each measurement to feet first, then multiply. There are 12 inches, 1/3 of a yard, and about 3.281 feet in a meter. This calculator handles the conversion for you — just pick your unit from the dropdown and enter the length and width in that unit.' },
  { question: 'How do I calculate square footage for multiple rooms?', answer: 'Calculate each rectangular section separately and add them together. For repeated identical areas, use the quantity field to multiply one area by the number of sections. For an irregular shape, split it into rectangles, find each area, and sum them.' },
  { question: 'How do I estimate material cost from square footage?', answer: 'Multiply the total square footage by the price per square foot. For flooring at $4.50 per square foot over 120 square feet, the cost is 120 × 4.50 = $540. Enter a price per square foot in this calculator to see the total cost, and consider adding 5–10% for waste and cuts.' },
  { question: 'What is the difference between square feet and linear feet?', answer: 'Linear feet measure length in a single direction, while square feet measure two-dimensional area (length × width). Flooring and land are sold by square foot; trim, fencing, and lumber are often sold by linear foot. They are not interchangeable.' },
]
---
<Layout
  title="Square Footage Calculator: Area & Material Cost"
  description="Calculate square footage from length and width in feet, inches, yards, or meters. Get area in ft², m², and yd², plus material cost. Free square footage calculator."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Other', href: '/calculators/other' },
    { name: 'Square Footage Calculator', href: '/calculators/square-footage-calculator' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/other" class="hover:text-blue-600">Other</a><span>›</span>
      <span class="text-gray-900">Square Footage Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Square Footage Calculator"
          description="Area from length × width, plus optional material cost"
          formulaId="square-footage"
          formulaFn={formulaFn}
          resultLabel="Total Area"
          inputs={[
            { id: 'length', label: 'Length', type: 'number', placeholder: '12', min: 0, step: 'any', defaultValue: 12 },
            { id: 'width', label: 'Width', type: 'number', placeholder: '10', min: 0, step: 'any', defaultValue: 10 },
            { id: 'unit', label: 'Measurement unit', type: 'select', defaultValue: 'feet', options: [
              { value: 'feet', label: 'Feet' },
              { value: 'inches', label: 'Inches' },
              { value: 'yards', label: 'Yards' },
              { value: 'meters', label: 'Meters' },
            ] },
            { id: 'qty', label: 'Quantity (identical areas, optional)', type: 'number', placeholder: '1', min: 1, step: 1 },
            { id: 'price', label: 'Price per ft² ($, optional)', type: 'number', placeholder: '0', min: 0, step: 'any' },
          ]}
          faqs={faqs}
          relatedCalcs={[
            { name: 'Area Calculator', href: '/calculators/area-calculator' },
            { name: 'Tile Calculator', href: '/calculators/tile-calculator' },
            { name: 'Paint Calculator', href: '/calculators/paint-calculator' },
            { name: 'Unit Converter', href: '/calculators/unit-converter-calculator' },
          ]}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 text-sm text-blue-900 leading-relaxed">
          <h3 class="font-bold mb-2">Handy conversions</h3>
          <div class="space-y-1 text-xs">
            <div class="flex justify-between"><span>1 yd²</span><span>9 ft²</span></div>
            <div class="flex justify-between"><span>1 m²</span><span>10.76 ft²</span></div>
            <div class="flex justify-between"><span>1 acre</span><span>43,560 ft²</span></div>
          </div>
          <p class="text-xs mt-3">Tip: add 5–10% for waste when buying flooring or tile.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
