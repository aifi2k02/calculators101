---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'
import { getRelated } from '../../lib/calculators'

const formulaFn = `
  const dStr = inputs.date
  if (!dStr) throw new Error('Enter a date.')
  const d = new Date(dStr + 'T00:00:00')
  if (isNaN(d.getTime())) throw new Error('Enter a valid date.')
  function isoWeek(dt) {
    const date = new Date(Date.UTC(dt.getFullYear(), dt.getMonth(), dt.getDate()))
    const dayNum = (date.getUTCDay() + 6) % 7
    date.setUTCDate(date.getUTCDate() - dayNum + 3)
    const firstThursday = date.getTime()
    date.setUTCMonth(0, 1)
    if (date.getUTCDay() !== 4) { date.setUTCMonth(0, 1 + ((4 - date.getUTCDay()) + 7) % 7) }
    return 1 + Math.ceil((firstThursday - date.getTime()) / 604800000)
  }
  function weeksInYear(y) {
    const p = (yr) => (yr + Math.floor(yr / 4) - Math.floor(yr / 100) + Math.floor(yr / 400)) % 7
    return (p(y) === 4 || p(y - 1) === 3) ? 53 : 52
  }
  const week = isoWeek(d)
  const yearStart = new Date(d.getFullYear(), 0, 0)
  const dayOfYear = Math.floor((d - yearStart) / 86400000)
  const quarter = Math.floor(d.getMonth() / 3) + 1
  const totalWeeks = weeksInYear(d.getFullYear())
  const weeksLeft = totalWeeks - week
  return {
    value: 'Week ' + week,
    stats: [
      { label: 'ISO Week Number', value: String(week) },
      { label: 'Weeks Left in Year', value: String(weeksLeft) },
      { label: 'Day of Year', value: String(dayOfYear) },
      { label: 'Quarter', value: 'Q' + quarter }
    ],
    breakdown: [
      'Date: ' + d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }),
      '—',
      'ISO 8601 week number: ' + week + ' of ' + totalWeeks,
      'Weeks remaining this year: ' + weeksLeft,
      'Day of the year: ' + dayOfYear,
      'Quarter: Q' + quarter,
      'ISO weeks start on Monday; week 1 contains the first Thursday of the year.'
    ],
    share: {
      kicker: 'That date is in',
      heroNumber: 'Week ' + week,
      heroSub: 'of ' + totalWeeks + ' — ISO week number',
      hook: 'Day ' + dayOfYear + ' of the year, quarter Q' + quarter + ', with ' + weeksLeft + ' weeks left.',
      chips: ['Week ' + week + '/' + totalWeeks, 'Q' + quarter, dayOfYear + ' days in']
    }
  }
`

const faqs = [
  { question: 'What is a week number?', answer: 'A week number tells you which week of the year a date falls in — from 1 up to 52 or 53. This calculator uses the ISO 8601 standard, where weeks start on Monday and week 1 is the week containing the year\'s first Thursday. Week numbers are widely used in business, manufacturing, and project planning, especially in Europe.' },
  { question: 'How is the ISO week number calculated?', answer: 'Under ISO 8601, week 1 is the week that contains the first Thursday of the year (equivalently, the week containing January 4). Weeks run Monday to Sunday. This means the first few days of January can belong to the last week of the previous year, and late December can fall in week 1 of the next year.' },
  { question: 'Why do some years have 53 weeks?', answer: 'Most years have 52 weeks, but a year has 53 ISO weeks when January 1 falls on a Thursday, or on a Wednesday in a leap year. This happens roughly every 5–6 years — 2026, for example, is a 53-week year in the ISO system.' },
  { question: 'What is the difference between ISO weeks and US weeks?', answer: 'ISO weeks start on Monday and use the first-Thursday rule. The common US convention starts weeks on Sunday and often counts week 1 as the week containing January 1. This calculator reports the ISO number, the international standard used in business and software.' },
  { question: 'What week number is it today?', answer: 'Pick today\'s date and the calculator shows the current ISO week number, how many weeks remain in the year, the day of the year, and the current quarter — a quick snapshot of where you are in the calendar.' },
]
---
<Layout
  title="Week Number Calculator: What Week of the Year Is It?"
  description="Find the ISO 8601 week number for any date, plus day of year, quarter, and weeks remaining. Free week number calculator — what week is it today?"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Other', href: '/calculators/other' },
    { name: 'Week Number Calculator', href: '/calculators/week-number-calculator' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/other" class="hover:text-blue-600">Other</a><span>›</span>
      <span class="text-gray-900">Week Number Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Week Number Calculator"
          description="The ISO week number for any date, plus day of year and quarter"
          formulaId="week-number"
          formulaFn={formulaFn}
          resultLabel="ISO Week Number"
          shareStyle="time"
          inputs={[
            { id: 'date', label: 'Pick a Date', type: 'date', defaultValue: '2026-01-15' },
          ]}
          intro="This week number calculator shows the ISO 8601 week number for any date — the international standard where weeks start on Monday and week 1 holds the year's first Thursday. It also gives the day of the year, the current quarter, and how many weeks remain in the year."
          disclaimer="Reports ISO 8601 week numbers (Monday start, first-Thursday rule), the standard in business and software. The US Sunday-start convention can differ by one week near the start and end of the year."
          lastUpdated="2026-07-26"
          faqs={faqs}
          relatedCalcs={getRelated('/calculators/week-number-calculator')}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5">
          <h3 class="font-bold text-blue-900 mb-2">ISO 8601 weeks</h3>
          <p class="text-xs text-blue-800">Weeks start <strong>Monday</strong>. Week 1 = the week with the year's first Thursday (the week containing Jan 4).</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <h3 class="font-bold text-gray-900 text-sm mb-2">52 or 53?</h3>
          <p class="text-xs text-gray-600">A year has 53 ISO weeks when Jan 1 is a Thursday (or Wednesday in a leap year). Otherwise, 52.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
