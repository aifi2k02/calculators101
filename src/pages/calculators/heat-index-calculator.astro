---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'
import { getRelated } from '../../lib/calculators'

const formulaFn = `
  let temp = parseFloat(inputs.temp)
  const rh = parseFloat(inputs.rh)
  const unit = inputs.unit || 'imperial'
  if (isNaN(temp)) throw new Error('Enter the air temperature.')
  if (isNaN(rh) || rh < 0 || rh > 100) throw new Error('Enter a relative humidity between 0 and 100%.')
  let T = unit === 'metric' ? temp * 9 / 5 + 32 : temp
  const round = x => Math.round(x * 10) / 10
  // NWS Rothfusz regression
  let HI
  const simple = 0.5 * (T + 61.0 + (T - 68.0) * 1.2 + rh * 0.094)
  if ((simple + T) / 2 < 80) {
    HI = simple
  } else {
    HI = -42.379 + 2.04901523 * T + 10.14333127 * rh - 0.22475541 * T * rh
      - 0.00683783 * T * T - 0.05481717 * rh * rh + 0.00122874 * T * T * rh
      + 0.00085282 * T * rh * rh - 0.00000199 * T * T * rh * rh
    if (rh < 13 && T >= 80 && T <= 112) {
      HI -= ((13 - rh) / 4) * Math.sqrt((17 - Math.abs(T - 95)) / 17)
    } else if (rh > 85 && T >= 80 && T <= 87) {
      HI += ((rh - 85) / 10) * ((87 - T) / 5)
    }
  }
  const hiOut = unit === 'metric' ? (HI - 32) * 5 / 9 : HI
  const u = unit === 'metric' ? '°C' : '°F'
  let risk, cls
  if (HI < 80) { risk = 'None — comfortable'; cls = 'safe' }
  else if (HI < 91) { risk = 'Caution — fatigue possible'; cls = 'caution' }
  else if (HI < 103) { risk = 'Extreme caution — cramps/heat exhaustion'; cls = 'warning' }
  else if (HI < 125) { risk = 'Danger — heat exhaustion likely'; cls = 'danger' }
  else { risk = 'Extreme danger — heat stroke imminent'; cls = 'extreme' }
  return {
    value: round(hiOut) + u,
    stats: [
      { label: 'Feels like', value: round(hiOut) + u },
      { label: 'Actual temp', value: round(temp) + u },
      { label: 'Humidity', value: round(rh) + '%' },
      { label: 'Risk level', value: risk }
    ],
    breakdown: [
      'Air temperature: ' + round(temp) + u,
      'Relative humidity: ' + round(rh) + '%',
      'NWS Rothfusz heat-index regression applied',
      'Heat index (feels like): ' + round(hiOut) + u,
      'Risk level: ' + risk
    ]
  }
`

const faqs = [
  { question: 'What is the heat index?', answer: 'The heat index, or apparent temperature, is how hot it really feels when relative humidity is combined with the actual air temperature. High humidity slows the evaporation of sweat, which is how your body cools itself, so a humid 90°F day feels far hotter and is more dangerous than a dry one.' },
  { question: 'How is the heat index calculated?', answer: 'This calculator uses the official National Weather Service Rothfusz regression, a multi-term equation of temperature and relative humidity, with the standard low-humidity and high-humidity adjustments. Below about 80°F the NWS uses a simpler averaging formula, which this tool applies automatically.' },
  { question: 'What heat index is dangerous?', answer: 'The NWS thresholds are: 80–90°F caution (fatigue possible), 91–103°F extreme caution (heat cramps and exhaustion possible), 103–124°F danger (heat exhaustion likely, heat stroke possible), and 125°F or above extreme danger (heat stroke highly likely). These assume shade — full sun can add up to 15°F.' },
  { question: 'Does the heat index account for direct sunlight?', answer: 'No. The official heat index is calculated for shady conditions. Direct sunlight can raise the apparent temperature by as much as 15°F (8°C), so exposure in full sun is more dangerous than the heat index alone suggests. Strong wind blowing over hot, humid skin can also make it feel worse.' },
  { question: 'What is the difference between heat index and wind chill?', answer: 'They are the warm- and cold-weather counterparts of "feels like" temperature. The heat index combines heat and humidity to show how hot it feels in summer, while wind chill combines cold and wind to show how cold it feels in winter. Heat index applies at high temperatures; wind chill applies at or below 50°F.' },
]
---
<Layout
  title="Heat Index Calculator: What the Heat Really Feels Like"
  description="Calculate the heat index (apparent temperature) from temperature and humidity using the official NWS formula. See the feels-like temperature and heat risk level."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Other', href: '/calculators/other' },
    { name: 'Heat Index Calculator', href: '/calculators/heat-index-calculator' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/other" class="hover:text-blue-600">Other</a><span>›</span>
      <span class="text-gray-900">Heat Index Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Heat Index Calculator"
          description="How hot it really feels, using the official NWS formula"
          formulaId="heat-index"
          formulaFn={formulaFn}
          resultLabel="Feels Like"
          inputs={[
            { id: 'unit', label: 'Units', type: 'select', defaultValue: 'imperial', options: [
              { value: 'imperial', label: 'Fahrenheit' },
              { value: 'metric', label: 'Celsius' },
            ] },
            { id: 'temp', label: 'Air temperature', type: 'number', placeholder: '90', step: 'any', defaultValue: 90 },
            { id: 'rh', label: 'Relative humidity (%)', type: 'number', placeholder: '70', min: 0, max: 100, step: 'any', defaultValue: 70 },
          ]}
          faqs={faqs}
          relatedCalcs={getRelated('/calculators/heat-index-calculator')}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 text-sm text-blue-900 leading-relaxed">
          <h3 class="font-bold mb-2">NWS risk levels</h3>
          <div class="space-y-1 text-xs">
            <div class="flex justify-between"><span>80–90°F</span><span>Caution</span></div>
            <div class="flex justify-between"><span>91–103°F</span><span>Extreme caution</span></div>
            <div class="flex justify-between"><span>103–124°F</span><span>Danger</span></div>
            <div class="flex justify-between"><span>125°F+</span><span>Extreme danger</span></div>
          </div>
          <p class="text-xs mt-3">Full sun can add up to 15°F to these values.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
