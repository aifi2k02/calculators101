---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'
import { getRelated, getBreadcrumbs } from '../../lib/calculators'

const formulaFn = `
  const principal = parseFloat(inputs.principal)
  const rate = parseFloat(inputs.rate)
  const years = parseFloat(inputs.years)
  const extra = parseFloat(inputs.extra) || 0
  if (isNaN(principal) || principal <= 0) throw new Error('Enter a valid loan balance.')
  if (isNaN(rate) || rate < 0) throw new Error('Enter a valid interest rate.')
  if (isNaN(years) || years <= 0) throw new Error('Enter a valid repayment term.')
  if (extra < 0) throw new Error('Extra payment cannot be negative.')
  const r = rate / 100 / 12
  const n = Math.round(years * 12)
  const monthly = r === 0 ? principal / n : (principal * r * Math.pow(1+r,n)) / (Math.pow(1+r,n) - 1)
  const totalStd = monthly * n
  const interestStd = totalStd - principal
  const simulate = pay => {
    let bal = principal, months = 0, interest = 0
    if (r > 0 && pay <= bal * r) return null
    while (bal > 0 && months < 12000) {
      const i = bal * r
      let princ = pay - i
      if (princ > bal) princ = bal
      interest += i; bal -= princ; months++
    }
    return { months, interest }
  }
  let payoffMonths = n, interestPaid = interestStd, interestSaved = 0, monthsSaved = 0
  if (extra > 0) {
    const sim = simulate(monthly + extra)
    if (sim) { payoffMonths = sim.months; interestPaid = sim.interest; interestSaved = interestStd - sim.interest; monthsSaved = n - sim.months }
  }
  const yrs = Math.floor(payoffMonths / 12), mos = payoffMonths % 12
  const stats = [
    { label: 'Monthly Payment', value: '$' + monthly.toFixed(2) },
    { label: 'Total Interest', value: '$' + Math.round(interestPaid).toLocaleString() },
    { label: 'Total Repaid', value: '$' + Math.round(principal + interestPaid).toLocaleString() },
    { label: 'Payoff Time', value: yrs + ' yr ' + mos + ' mo' },
  ]
  if (extra > 0) {
    stats.push({ label: 'Interest Saved', value: '$' + Math.round(interestSaved).toLocaleString() })
    stats.push({ label: 'Paid Off Sooner', value: Math.floor(monthsSaved/12) + ' yr ' + (monthsSaved%12) + ' mo' })
  }
  const breakdown = [
    'Loan balance: $' + principal.toLocaleString(),
    'Rate: ' + rate + '% → monthly ' + (rate/12).toFixed(4) + '%',
    'Standard term: ' + years + ' years (' + n + ' payments)',
    'Required monthly payment: $' + monthly.toFixed(2),
    '—',
    'Standard total interest: $' + Math.round(interestStd).toLocaleString(),
  ]
  if (extra > 0) {
    breakdown.push('With $' + extra + '/mo extra → paid off in ' + yrs + ' yr ' + mos + ' mo')
    breakdown.push('Interest saved: $' + Math.round(interestSaved).toLocaleString())
  }
  return { value: '$' + monthly.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}), gaugeValue: Math.min(rate, 15), stats, breakdown }
`

const gauge = {
  min: 0, max: 15, unit: '% rate',
  zones: [
    { label: 'Low <5%', color: '#22c55e', from: 0, to: 5 },
    { label: 'Typical 5-8%', color: '#3b82f6', from: 5, to: 8 },
    { label: 'High 8-12%', color: '#f59e0b', from: 8, to: 12 },
    { label: 'Very high 12%+', color: '#ef4444', from: 12, to: 15 },
  ]
}

const faqs = [
  { question: 'How is a student loan monthly payment calculated?', answer: 'It uses the standard amortization formula: M = P x r x (1+r)^n / ((1+r)^n - 1), where P is the balance, r is the monthly rate (annual ÷ 12), and n is the number of months. A $30,000 loan at 6% over 10 years is about $333/month.' },
  { question: 'How much can extra payments save me?', answer: 'A lot, because extra money goes straight to principal and stops future interest. Enter an extra monthly amount and the calculator shows how many years earlier you finish and how much interest you avoid. Even $50/month can cut months off a 10-year loan.' },
  { question: 'What is the standard student loan repayment term?', answer: 'Federal Standard Repayment is 10 years (120 payments). Extended and income-driven plans can run 20–25 years, which lowers the monthly payment but greatly increases total interest. Try both terms to compare.' },
  { question: 'Should I pay off student loans early?', answer: 'If your loan rate is higher than what you could reliably earn by investing, paying extra usually wins. Federal loans have flexible protections, so weigh those benefits — but for high-rate private loans, extra payments are almost always worthwhile.' },
  { question: 'Does this include interest that accrues during school?', answer: 'This calculator models the repayment period on a fixed starting balance. If interest accrued and capitalized during school or a grace period, enter the higher post-capitalization balance for an accurate estimate.' }
]
---
<Layout
  title="Student Loan Calculator: Monthly Payment & Payoff"
  description="Calculate your student loan monthly payment, total interest, and payoff date. See how much extra payments save on federal or private student loans."
  breadcrumbs={getBreadcrumbs('/calculators/student-loan-calculator')}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/financial" class="hover:text-blue-600">Financial</a><span>›</span>
      <a href="/calculators/loans" class="hover:text-blue-600">Loans &amp; Mortgage</a><span>›</span>
      <span class="text-gray-900">Student Loan Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Student Loan Calculator"
          description="Monthly payment, total interest, and the payoff boost from extra payments"
          formulaId="student-loan"
          formulaFn={formulaFn}
          resultLabel="Monthly Payment"
          gauge={gauge}
          inputs={[
            { id: 'principal', label: 'Loan Balance ($)', type: 'number', placeholder: '30000', min: 1, defaultValue: 30000 },
            { id: 'rate', label: 'Interest Rate (% APR)', type: 'number', placeholder: '6', min: 0, step: 0.01, defaultValue: 6 },
            { id: 'years', label: 'Repayment Term (years)', type: 'number', placeholder: '10', min: 1, max: 30, defaultValue: 10 },
            { id: 'extra', label: 'Extra Monthly Payment ($, optional)', type: 'number', placeholder: '0', min: 0, defaultValue: 0 },
          ]}
          faqs={faqs}
          relatedCalcs={getRelated('/calculators/student-loan-calculator')}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5">
          <h3 class="font-bold text-blue-900 mb-3">Tips to pay less interest</h3>
          <ul class="text-xs text-blue-800 space-y-2 list-disc pl-4">
            <li>Add even a small extra amount each month — it all hits principal.</li>
            <li>Make payments during the grace period to stop interest capitalizing.</li>
            <li>Refinancing a high-rate private loan can lower the rate (you lose federal protections).</li>
            <li>Autopay often earns a 0.25% rate discount.</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
