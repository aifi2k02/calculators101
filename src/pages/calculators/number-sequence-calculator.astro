---
import Layout from '../../layouts/Layout.astro'
import Calculator from '../../components/Calculator.astro'

const formulaFn = `
  const type = inputs.type || 'arithmetic'
  const a = parseFloat(inputs.a)
  const d = parseFloat(inputs.d)
  const n = parseFloat(inputs.n)
  if (isNaN(a)) throw new Error('Enter the first term.')
  if (isNaN(d)) throw new Error(type === 'geometric' ? 'Enter the common ratio.' : 'Enter the common difference.')
  if (isNaN(n) || n < 1 || Math.floor(n) !== n) throw new Error('Enter a whole number of terms (n ≥ 1).')
  const round = x => Math.round(x * 1e6) / 1e6
  let nth, sum, terms = []
  if (type === 'arithmetic') {
    nth = a + (n - 1) * d
    sum = n / 2 * (2 * a + (n - 1) * d)
  } else {
    nth = a * Math.pow(d, n - 1)
    sum = d === 1 ? a * n : a * (1 - Math.pow(d, n)) / (1 - d)
  }
  const show = Math.min(n, 10)
  for (let k = 0; k < show; k++) {
    terms.push(round(type === 'arithmetic' ? a + k * d : a * Math.pow(d, k)))
  }
  const preview = terms.join(', ') + (n > 10 ? ', …' : '')
  return {
    value: 'aₙ = ' + round(nth),
    stats: [
      { label: 'nth term (a' + n + ')', value: String(round(nth)) },
      { label: 'Sum of ' + n + ' terms', value: String(round(sum)) },
      { label: type === 'geometric' ? 'Common ratio' : 'Common difference', value: String(d) },
      { label: 'First term', value: String(a) }
    ],
    breakdown: [
      'Sequence type: ' + (type === 'geometric' ? 'Geometric' : 'Arithmetic'),
      'First term (a₁): ' + a,
      (type === 'geometric' ? 'Common ratio (r): ' : 'Common difference (d): ') + d,
      'Number of terms (n): ' + n,
      type === 'geometric' ? 'nth term: a·r^(n−1) = ' + round(nth) : 'nth term: a + (n−1)d = ' + round(nth),
      'Sum of first ' + n + ' terms: ' + round(sum),
      'Sequence: ' + preview
    ]
  }
`

const faqs = [
  { question: 'What is an arithmetic sequence?', answer: 'An arithmetic sequence is a list of numbers where each term increases by a fixed amount called the common difference (d). For example, 2, 5, 8, 11 has a common difference of 3. The nth term is a + (n−1)d, and the sum of the first n terms is n/2 × (2a + (n−1)d).' },
  { question: 'What is a geometric sequence?', answer: 'A geometric sequence multiplies each term by a fixed value called the common ratio (r). For example, 3, 6, 12, 24 has a common ratio of 2. The nth term is a × r^(n−1), and the sum of the first n terms is a × (1 − r^n) ÷ (1 − r) when r is not 1.' },
  { question: 'How do I find the nth term of a sequence?', answer: 'For an arithmetic sequence, use a + (n−1)d. For a geometric sequence, use a × r^(n−1). Enter the first term, the common difference or ratio, and the position n, and this calculator returns that term along with the running sum and a preview of the sequence.' },
  { question: 'What is the difference between a sequence and a series?', answer: 'A sequence is an ordered list of numbers (the terms). A series is the sum of those terms. This calculator gives you both: the individual nth term of the sequence and the series total — the sum of the first n terms.' },
  { question: 'Can the common difference or ratio be negative or a fraction?', answer: 'Yes. A negative common difference makes an arithmetic sequence decrease (10, 7, 4, 1…). A common ratio between 0 and 1 makes a geometric sequence shrink toward zero (16, 8, 4, 2…), and a negative ratio makes the terms alternate sign. This calculator handles all of these cases.' },
]
---
<Layout
  title="Number Sequence Calculator: Arithmetic & Geometric"
  description="Find the nth term and the sum of an arithmetic or geometric sequence. Free number sequence calculator with a step-by-step breakdown and sequence preview."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Math', href: '/calculators/math' },
    { name: 'Number Sequence Calculator', href: '/calculators/number-sequence-calculator' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs text-gray-500 mb-6 flex gap-1 items-center flex-wrap">
      <a href="/" class="hover:text-blue-600">Home</a><span>›</span>
      <a href="/calculators/math" class="hover:text-blue-600">Math</a><span>›</span>
      <span class="text-gray-900">Number Sequence Calculator</span>
    </nav>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Calculator
          title="Number Sequence Calculator"
          description="nth term and sum of an arithmetic or geometric sequence"
          formulaId="number-sequence"
          formulaFn={formulaFn}
          resultLabel="nth Term"
          inputs={[
            { id: 'type', label: 'Sequence type', type: 'select', defaultValue: 'arithmetic', options: [
              { value: 'arithmetic', label: 'Arithmetic (add a fixed amount)' },
              { value: 'geometric', label: 'Geometric (multiply by a fixed ratio)' },
            ] },
            { id: 'a', label: 'First term (a₁)', type: 'number', placeholder: '2', step: 'any', defaultValue: 2 },
            { id: 'd', label: 'Common difference / ratio', type: 'number', placeholder: '3', step: 'any', defaultValue: 3 },
            { id: 'n', label: 'Number of terms (n)', type: 'number', placeholder: '10', min: 1, step: 1, defaultValue: 10 },
          ]}
          faqs={faqs}
          relatedCalcs={[
            { name: 'Combination Calculator', href: '/calculators/combination-calculator' },
            { name: 'Factorial Calculator', href: '/calculators/factorial-calculator' },
            { name: 'Average Calculator', href: '/calculators/average-calculator' },
            { name: 'Exponent Calculator', href: '/calculators/exponent-calculator' },
          ]}
        />
      </div>
      <aside class="space-y-5">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 text-sm text-blue-900 leading-relaxed">
          <h3 class="font-bold mb-2">Formulas</h3>
          <p class="text-xs mb-1"><strong>Arithmetic</strong></p>
          <p class="font-mono text-xs mb-1">aₙ = a + (n−1)d</p>
          <p class="font-mono text-xs mb-3">Sₙ = n/2 · (2a + (n−1)d)</p>
          <p class="text-xs mb-1"><strong>Geometric</strong></p>
          <p class="font-mono text-xs mb-1">aₙ = a · r^(n−1)</p>
          <p class="font-mono text-xs">Sₙ = a(1 − rⁿ)/(1 − r)</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
